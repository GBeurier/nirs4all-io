# Compile the C glue against the committed C ABI header and link the prebuilt
# nirs4all-io-capi cdylib. Set these before `R CMD INSTALL` (see build_and_test.sh):
#   N4IO_INCLUDE  -> dir containing nirs4all_io.h
#   N4IO_CAPI_DIR -> dir containing libnirs4all_io_capi.so
PKG_CPPFLAGS = -I$(N4IO_INCLUDE)
PKG_LIBS = -L$(N4IO_CAPI_DIR) -lnirs4all_io_capi -Wl,-rpath,$(N4IO_CAPI_DIR)
